<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:CopilotBridgeAndroid.Models"
             x:Class="CopilotBridgeAndroid.Pages.SessionsPage"
             Title="Copilot Bridge">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="＋ 新会话" Clicked="OnNewClicked" />
        <ToolbarItem Text="设置" Clicked="OnSettingsClicked" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="*,Auto">

        <RefreshView Grid.Row="0" x:Name="Refresher" Refreshing="OnRefreshing">
            <CollectionView x:Name="SessionsView"
                            SelectionMode="Single"
                            SelectionChanged="OnSessionSelected">

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:SessionListItem">
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems Mode="Reveal">
                                    <SwipeItem Text="重命名"
                                               BackgroundColor="#0F6CBD"
                                               Invoked="OnRenameInvoked"
                                               CommandParameter="{Binding .}" />
                                    <SwipeItem Text="删除"
                                               BackgroundColor="#D13A3A"
                                               Invoked="OnDeleteInvoked"
                                               CommandParameter="{Binding .}" />
                                </SwipeItems>
                            </SwipeView.RightItems>

                            <Grid Padding="16,12" RowDefinitions="Auto,Auto" BackgroundColor="White">
                                <Label Grid.Row="0" Text="{Binding DisplayTitle}"
                                       FontSize="16" LineBreakMode="TailTruncation"
                                       TextColor="#1F1F1F" />
                                <Label Grid.Row="1" Text="{Binding RelativeTime}"
                                       FontSize="12" TextColor="#888888" Margin="0,2,0,0" />
                            </Grid>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <Grid Padding="30,60">
                        <Label HorizontalTextAlignment="Center" TextColor="#999999"
                               Text="还没有会话。点击右上角「＋ 新会话」开始，或在「设置」里检测连接。" />
                    </Grid>
                </CollectionView.EmptyView>
            </CollectionView>
        </RefreshView>

        <Border Grid.Row="1" BackgroundColor="#ECECEC" Padding="14,8"
                StrokeThickness="0">
            <HorizontalStackLayout Spacing="8">
                <BoxView x:Name="StatusDot" WidthRequest="9" HeightRequest="9"
                         CornerRadius="5" Color="#B0B0B0" VerticalOptions="Center" />
                <Label x:Name="StatusText" Text="未连接" FontSize="12"
                       TextColor="#666666" VerticalOptions="Center"
                       LineBreakMode="TailTruncation" />
            </HorizontalStackLayout>
        </Border>

    </Grid>

</ContentPage>
