<Window x:Class="CopilotBridgeClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CopilotBridgeClient"
        xmlns:md="clr-namespace:CopilotBridgeClient.Markdown"
        Title="Copilot Bridge 客户端" Height="740" Width="960"
        MinHeight="520" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Background="{StaticResource WindowBg}">

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="252" MinWidth="220" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- ============================ SIDEBAR ============================ -->
    <Grid Grid.Column="0" Background="{StaticResource SidebarBg}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Header: app title + New -->
      <Border Grid.Row="0" Padding="14,14,12,10"
              BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,1,1">
        <DockPanel LastChildFill="False">
          <TextBlock Text="Copilot Bridge" FontSize="16" FontWeight="SemiBold"
                     Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
          <Button DockPanel.Dock="Right" x:Name="NewBtn" Content="＋ 新会话"
                  Style="{StaticResource SubtleButton}" Click="NewConversation_Click" />
        </DockPanel>
      </Border>

      <!-- Connection settings (collapsible, collapsed by default) -->
      <Border Grid.Row="1" Padding="12,4,12,8"
              BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,1,1">
        <Expander x:Name="SettingsExpander" Header="⚙ 连接设置" IsExpanded="False"
                  Foreground="{StaticResource TextSecondary}">
          <StackPanel Margin="0,8,0,2">
            <TextBlock Text="服务器地址" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="ServerBox" IsEditable="True" FontSize="13" Padding="8,6">
              <ComboBoxItem Content="http://localhost:3978" />
              <ComboBoxItem Content="https://your-tunnel-3978.devtunnels.ms" />
            </ComboBox>

            <TextBlock Text="API Key（X-API-Key，可留空）" Style="{StaticResource FieldLabel}"
                       Margin="2,10,0,3" />
            <PasswordBox x:Name="KeyBox" Style="{StaticResource RoundedPassword}" />

            <Button x:Name="ConnectBtn" Content="检测连接 / 刷新会话" Margin="0,10,0,0"
                    HorizontalAlignment="Left" Style="{StaticResource SubtleButton}"
                    Click="Connect_Click" />
          </StackPanel>
        </Expander>
      </Border>

      <!-- Session list -->
      <ListBox Grid.Row="2" x:Name="SessionsList" Style="{StaticResource SessionListBox}"
               ItemsSource="{Binding Sessions}" SelectionChanged="SessionsList_SelectionChanged"
               BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,1,0">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel>
              <StackPanel.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="重命名" Click="RenameSession_Click" />
                  <MenuItem Header="删除" Click="DeleteSession_Click" />
                </ContextMenu>
              </StackPanel.ContextMenu>
              <TextBlock Text="{Binding DisplayTitle}" FontSize="13.5" TextTrimming="CharacterEllipsis"
                         Foreground="{StaticResource TextPrimary}" />
              <TextBlock Text="{Binding RelativeTime}" FontSize="11" Margin="0,2,0,0"
                         Foreground="{StaticResource TextSecondary}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- Connection status -->
      <Border Grid.Row="3" Background="#ECECEC" Padding="14,6"
              BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,1,1,0">
        <StackPanel Orientation="Horizontal">
          <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#B0B0B0" VerticalAlignment="Center" />
          <TextBlock x:Name="StatusText" Text="未连接" Margin="8,0,0,0" FontSize="12"
                     TextTrimming="CharacterEllipsis"
                     Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- ============================ CHAT PANE ============================ -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Active session header -->
      <Border Grid.Row="0" Background="{StaticResource CardBg}" Padding="18,12"
              BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,0,1">
        <TextBlock x:Name="ChatTitle" Text="Copilot Bridge" FontSize="15" FontWeight="SemiBold"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
      </Border>

      <!-- Transcript -->
      <ScrollViewer Grid.Row="1" x:Name="Scroller" Padding="6,10"
                    VerticalScrollBarVisibility="Auto" CanContentScroll="False">
        <ItemsControl x:Name="MessagesList" ItemsSource="{Binding Messages}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="10,5">
                <Border CornerRadius="12" Padding="13,9" MaxWidth="620"
                        HorizontalAlignment="{Binding Role, Converter={StaticResource RoleToAlign}}"
                        Background="{Binding Role, Converter={StaticResource RoleToBrush}}">
                  <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Direction="270"
                                      Color="#000000" Opacity="0.10" />
                  </Border.Effect>
                  <StackPanel>
                    <TextBlock Text="{Binding Header}" FontSize="11" Opacity="0.75"
                               Margin="0,0,0,3"
                               Foreground="{Binding Role, Converter={StaticResource RoleToFg}}" />

                    <!-- image attachments (renders nothing when empty) -->
                    <ItemsControl ItemsSource="{Binding Images}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border CornerRadius="8" Margin="0,0,6,6" ClipToBounds="True"
                                  HorizontalAlignment="Left">
                            <Image Source="{Binding Source}" MaxHeight="220" MaxWidth="300"
                                   Stretch="Uniform" />
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- busy state -->
                    <StackPanel Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                      <TextBlock Text="{Binding BusyText}" FontSize="13"
                                 Foreground="{Binding Role, Converter={StaticResource RoleToFg}}" />
                      <ProgressBar IsIndeterminate="True" Height="3" Width="170" Margin="0,6,0,2"
                                   HorizontalAlignment="Left" Background="Transparent"
                                   Foreground="{StaticResource Accent}" BorderThickness="0" />
                    </StackPanel>

                    <!-- user / system message text (plain, selectable) -->
                    <TextBox Text="{Binding Text, Mode=OneWay}"
                             IsReadOnly="True" BorderThickness="0" Background="Transparent"
                             TextWrapping="Wrap" FontSize="14"
                             Foreground="{Binding Role, Converter={StaticResource RoleToFg}}"
                             Padding="0" IsTabStop="False">
                      <TextBox.Style>
                        <Style TargetType="TextBox">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <MultiDataTrigger>
                              <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsBusy}" Value="False" />
                                <Condition Binding="{Binding Role}" Value="User" />
                              </MultiDataTrigger.Conditions>
                              <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                              <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsBusy}" Value="False" />
                                <Condition Binding="{Binding Role}" Value="System" />
                              </MultiDataTrigger.Conditions>
                              <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBox.Style>
                    </TextBox>

                    <!-- assistant reply rendered as Markdown (selectable, links clickable) -->
                    <RichTextBox IsReadOnly="True" IsDocumentEnabled="True" IsTabStop="False"
                                 BorderThickness="0" Padding="0" Background="Transparent"
                                 HorizontalScrollBarVisibility="Disabled"
                                 VerticalScrollBarVisibility="Disabled"
                                 PreviewMouseWheel="AssistantRtb_PreviewMouseWheel"
                                 md:MarkdownProps.Foreground="{Binding Role, Converter={StaticResource RoleToFg}}"
                                 md:MarkdownProps.Text="{Binding Text}">
                      <RichTextBox.Style>
                        <Style TargetType="RichTextBox">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <MultiDataTrigger>
                              <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsBusy}" Value="False" />
                                <Condition Binding="{Binding Role}" Value="Assistant" />
                              </MultiDataTrigger.Conditions>
                              <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                          </Style.Triggers>
                        </Style>
                      </RichTextBox.Style>
                    </RichTextBox>
                  </StackPanel>
                </Border>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <!-- Input -->
      <Border Grid.Row="2" Background="{StaticResource CardBg}" Padding="14,12"
              BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,1,0,0">
        <StackPanel>
          <!-- pending image attachments (preview strip; empty => no items) -->
          <ItemsControl x:Name="PendingList" ItemsSource="{Binding PendingImages}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Width="64" Height="64" Margin="0,0,8,8">
                  <Border CornerRadius="8" ClipToBounds="True">
                    <Image Source="{Binding Source}" Stretch="UniformToFill" Width="64" Height="64" />
                  </Border>
                  <Button Content="✕" Width="18" Height="18" Padding="0" FontSize="10"
                          HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0"
                          ToolTip="移除" Click="RemovePending_Click" Tag="{Binding}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="8" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="10" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="AttachBtn" Content="📎" MinWidth="44"
                    VerticalAlignment="Stretch" Style="{StaticResource SubtleButton}"
                    ToolTip="添加图片" Click="Attach_Click" />
            <TextBox Grid.Column="2" x:Name="InputBox" Style="{StaticResource RoundedTextBox}"
                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="46" MaxHeight="150"
                     VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Center"
                     PreviewKeyDown="InputBox_PreviewKeyDown" />
            <Button Grid.Column="4" x:Name="SendBtn" Content="发送" MinWidth="84"
                    VerticalAlignment="Stretch" Style="{StaticResource AccentButton}"
                    Click="Send_Click" />
          </Grid>
          <TextBlock Text="Enter 发送，Shift+Enter 换行；可点 📎 添加图片" FontSize="11" Margin="2,7,0,0"
                     Foreground="#9A9A9A" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
