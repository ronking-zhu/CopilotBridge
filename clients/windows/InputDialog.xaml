<Window x:Class="CopilotBridgeClient.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="重命名会话" SizeToContent="Height" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" FontFamily="Segoe UI Variable Text, Segoe UI"
        Background="{StaticResource CardBg}">
  <StackPanel Margin="20">
    <TextBlock x:Name="PromptText" FontSize="14" TextWrapping="Wrap"
               Foreground="{StaticResource TextPrimary}" Margin="0,0,0,10" />
    <TextBox x:Name="InputText" Style="{StaticResource RoundedTextBox}" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="取消" Style="{StaticResource SubtleButton}" MinWidth="72"
              IsCancel="True" Margin="0,0,8,0" Click="Cancel_Click" />
      <Button Content="确定" Style="{StaticResource AccentButton}" MinWidth="72"
              IsDefault="True" Click="Ok_Click" />
    </StackPanel>
  </StackPanel>
</Window>
