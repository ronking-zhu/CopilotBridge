# ===== Azure Bot / Bot Framework =====
# Leave APP_ID/PASSWORD empty for LOCAL testing (local_test.py / Bot Framework Emulator).
# Fill them with your Azure Bot's Microsoft App registration for DevTunnel + Teams use.
MicrosoftAppId=
MicrosoftAppPassword=
# MultiTenant | SingleTenant | UserAssignedMSID
MicrosoftAppType=MultiTenant
# Required only when MicrosoftAppType=SingleTenant
MicrosoftAppTenantId=

# ===== Local server =====
HOST=localhost
PORT=3978

# ===== GitHub Copilot CLI =====
# Empty = auto-discover the installed copilot executable.
COPILOT_PATH=
# 'workdir' = restrict file access to COPILOT_WORKDIR (safer).
# 'full'    = whole-machine access (passes --allow-all to copilot).
COPILOT_SCOPE=workdir
# Sandbox folder for 'workdir' scope. Empty = <project>/workspace
COPILOT_WORKDIR=
# Optional model override (e.g. gpt-5.2). Empty = Copilot default.
COPILOT_MODEL=
# Hard timeout (seconds) for a single Copilot run. 0 = NO timeout (recommended):
# AI tasks can run for a long time, so let Copilot finish and watch the client's
# progress indicator. Set a positive number only if you want a hard cap.
COPILOT_TIMEOUT=0
# Keep one Copilot session per Teams conversation for follow-up context.
COPILOT_SESSION_CONTINUITY=true

# ===== AI provider (pluggable backend) =====
# Which tool answers prompts: copilot (default) | claude | openai.
AI_PROVIDER=copilot
# Claude CLI: empty = auto-discover 'claude' on PATH. Optional model override.
CLAUDE_PATH=
CLAUDE_MODEL=
# OpenAI (or any OpenAI-compatible endpoint). Only used when AI_PROVIDER=openai.
# OPENAI_API_KEY enables the provider; BASE_URL/MODEL are optional overrides.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# ===== Security / UX =====
# Comma-separated AAD object ids allowed to use the bot.
# EMPTY = allow everyone who can reach the bot (NOT recommended).
# Get yours by messaging the bot:  /whoami
ALLOWED_USER_IDS=
MAX_REPLY_CHARS=16000
CHUNK_CHARS=3500

# ===== Image / file attachments (mobile & web clients) =====
# Clients can attach images to a chat turn; the server saves them under
# <workdir>/.uploads/<sessionId>/ and passes each to Copilot via --attachment.
# Per-file size cap (MB) and max images per turn (guards abuse over the tunnel).
MAX_ATTACHMENT_MB=25
MAX_ATTACHMENTS=8

# Token for the direct mobile/web chat API (/api/chat), exposed via the tunnel.
# EMPTY = NO auth (anyone with the tunnel URL can run Copilot). Set a strong random value.
CHAT_API_TOKEN=

# ===== Identity / auth policy for the direct chat API =====
# apikey (default) = the shared CHAT_API_TOKEN above.
# entra            = Microsoft Entra ID (Azure AD) sign-in only; clients sign in
#                    with microsoft.com + Authenticator (MFA via Conditional
#                    Access) and the shared key is rejected. No static secret on
#                    devices. Requires an Entra app registration (see below).
# both             = accept either, for a phased migration.
AUTH_MODE=apikey
# --- Entra ID settings (only used when AUTH_MODE is entra or both) ---
# Your tenant GUID (single-tenant, recommended) or 'organizations'/'common'.
# On first run Copilot Bridge auto-detects THIS device's tenant and fills it in
# here; you can also set/change it from the Control Panel (Configure…) or by hand.
ENTRA_TENANT_ID=
# The app registration's client id (the clients use this to sign in).
ENTRA_CLIENT_ID=
# Audience the access token is issued for: the API's Application ID URI
# (api://<client-id>) and/or the client id. Comma-separated to accept more than one.
ENTRA_AUDIENCE=
# Scope(s) the client requests, e.g. api://<client-id>/access_as_user.
ENTRA_SCOPES=
# WHO may use it (fail-closed: at least ONE must be set, else every token is denied).
# Prefer an app role or security group over a flat user list.
ENTRA_ALLOWED_USERS=        # object ids and/or emails/UPNs, comma-separated
ENTRA_ALLOWED_GROUPS=       # Entra security-group object ids (needs groups claim)
ENTRA_ALLOWED_ROLES=        # app-role values defined on the app registration

# ===== Dev Tunnel (public ingress, used by launcher.py) =====
# When enabled, launcher.py auto-starts a Microsoft Dev Tunnel after the server is
# healthy and prints the public HTTPS URL. Requires a one-time `devtunnel user login`.
TUNNEL_ENABLED=true
# Dev Tunnel ids are GLOBALLY unique across the whole Dev Tunnels service, so a
# shared id collides between machines ("Unauthorized tunnel access ... expected
# [host]"). Leave this BLANK/unset and the server mints a host-unique id
# (copilot-bridge-<random>) on first run. Only set it to pin a specific id you own.
# TUNNEL_ID=
# Tunnel-LAYER access control (who may reach the relay at all). MS edition default
# is 'private' = Microsoft Entra, OWNER-ONLY: only the account that signed into Dev
# Tunnel on this host can connect (most secure). Requires `devtunnel user login`.
#   private    = owner-only Microsoft sign-in (default, recommended).
#   tenant     = any member of the host's Entra tenant.
#   anonymous  = anyone with the URL (the app-layer API key is the only gate).
#   org:<name> = members of a GitHub organization.
TUNNEL_AUTH=private
# Empty = auto-discover devtunnel (bundled tools/ -> PATH -> winget link).
DEVTUNNEL_PATH=